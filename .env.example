# Servidor
PORT=3001
NODE_ENV=development
APP_API_PREFIX=/api/v1

# Quantos processos Node subir (usa todos os núcleos). Vazio = nº de CPUs do
# container. Ponha 1 para desligar o cluster (VPS de 1 core ou debug).
WEB_CONCURRENCY=

# Banco de Dados
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bankerpro_db
DB_LOGGING=true

# Pool de conexões POR WORKER. O total = WEB_CONCURRENCY x DB_POOL_MAX precisa
# caber no max_connections do Postgres (default 100). Ex.: 4 workers x 15 = 60.
DB_POOL_MAX=15
DB_POOL_MIN=2

# ─────────────────────────────────────────────────
# Redis / Fila (análise de áudio assíncrona)
# ─────────────────────────────────────────────────
# Deixe VAZIO para desligar a fila: a análise de áudio roda de forma síncrona,
# como antes. Preencha para ativar o processamento em segundo plano.
# Use REDIS_URL (recomendado) OU os campos separados abaixo.
REDIS_URL=
# Alternativa aos campos separados (usados só se REDIS_URL estiver vazio):
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# Quantas análises de áudio processam ao mesmo tempo. O freio que impede uma
# rajada de saturar a máquina. Numa VPS de 2 núcleos, 1 ou 2 é o recomendado.
AUDIO_WORKER_CONCURRENCY=2

# Limites de requisição por usuário/minuto nos endpoints que gastam dinheiro.
# Generosos: só um loop/abuso bate no teto. Protegem a fatura de IA e a máquina.
RATE_LIMIT_AI=40
RATE_LIMIT_AUDIO=10
# Tentativas de login/OTP por minuto (IP + e-mail). Segurança, não custo: é o que
# impede força bruta de senha e do código de 6 dígitos do reset.
RATE_LIMIT_AUTH=10
# Pedidos de código por hora (cadastro, reenviar OTP, esqueci a senha).
RATE_LIMIT_OTP=5

# Origens de navegador autorizadas além de localhost e *.easypanel.host.
# Separadas por vírgula. Ex.: https://closeria.com.br,https://www.closeria.com.br
CORS_ORIGINS=

# ─────────────────────────────────────────────────
# JWT — OBRIGATÓRIO
# ─────────────────────────────────────────────────
# Assina os tokens de sessão. Em produção a API NÃO SOBE sem esta variável, e
# rejeita valores curtos (< 32 caracteres) ou de exemplo. Gere o seu com:
#   openssl rand -hex 32
# NUNCA reaproveite um segredo que já tenha aparecido em repositório público.
# Trocar este valor derruba todas as sessões abertas (todo mundo refaz login).
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────
# Admin inicial (usado só quando o banco está vazio)
# ─────────────────────────────────────────────────
# Sem ADMIN_PASSWORD, o boot sorteia uma senha forte e a mostra uma única vez no
# log do deploy.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Integrações de Terceiros
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Só para transcrever o áudio da Análise de Áudio (a Anthropic não recebe áudio).
OPENAI_API_KEY=your_openai_api_key_here
MP_ACCESS_TOKEN=your_mercado_pago_access_token_here
MP_PUBLIC_KEY=your_mercado_pago_public_key_here
MP_CLIENT_ID=your_mercado_pago_client_id_here
MP_CLIENT_SECRET=your_mercado_pago_client_secret_here
MP_WEBHOOK_SECRET=your_mercado_pago_webhook_secret_here
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here
# Z-API (WhatsApp) — dados da instância no painel https://app.z-api.io
# A URL da sua instância tem o formato:
#   https://api.z-api.io/instances/{ZAPI_INSTANCE_ID}/token/{ZAPI_INSTANCE_TOKEN}/send-text
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
# "Token de segurança da conta" (Segurança > Token). Vai no header Client-Token.
# Deixe vazio se o token de segurança estiver desligado na conta.
ZAPI_CLIENT_TOKEN=
# Só mude se usar um domínio próprio/on-premise da Z-API.
ZAPI_BASE_URL=https://api.z-api.io

# URL pública desta API (sem barra no final). Usada para registrar o webhook do
# WhatsApp automaticamente no boot E como base das imagens dos e-mails
# (a API serve /assets estático; o hero do e-mail fica em /assets/email).
# Ex.: https://bankerpro-bankerpro--api.wohb2u.easypanel.host
APP_PUBLIC_URL=

# ─────────────────────────────────────────────────
# E-mail transacional (Resend) — boas-vindas e reset de senha
# ─────────────────────────────────────────────────
# Chave da API do Resend (https://resend.com). Sem ela, os e-mails não são
# enviados (o app não quebra: loga o aviso e segue).
RESEND_API_KEY=
# Remetente. O domínio precisa estar verificado no Resend.
MAIL_FROM=Closer.IA <ola@closeria.com.br>
# URL pública do site/app (front), usada no botão "Acessar a plataforma" dos
# e-mails. Sem barra no final. Ex.: https://closeria.com.br
APP_WEB_URL=

# ─────────────────────────────────────────────────
# Agente Codex (IA Desenvolvedora externa)
# ─────────────────────────────────────────────────
# Este módulo executa SQL arbitrário no banco. Deixe VAZIO para mantê-lo
# desligado (as rotas /codex respondem 404). Para ligar, gere um token próprio:
#   openssl rand -hex 32
CODEX_TOKEN=

# ─────────────────────────────────────────────────
# Estrutura do banco e ferramentas de SQL
# ─────────────────────────────────────────────────
# Ligado (padrão) o boot ajusta as tabelas conforme os models. Passe para false
# quando adotarem migrações, para o schema não mudar sozinho em produção.
DB_AUTO_SYNC=true

# As ferramentas de SQL (módulo Codex e agente de IA do painel) aceitam somente
# leitura por padrão. Ligue temporariamente para rodar uma escrita pontual.
SQL_ALLOW_WRITE=false

# Tentativas de código de vínculo do WhatsApp por minuto, por usuário.
RATE_LIMIT_LINK_CODE=5
# Eventos de analytics por minuto, por IP (rota pública).
RATE_LIMIT_COLLECT=60
